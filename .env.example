PORT=3000
# Use 127.0.0.1, not localhost: on Windows localhost resolves to ::1 which MongoDB may not listen on.
MONGO_URL=mongodb://127.0.0.1:27017/invoice_ocr
OLLAMA_URL=http://127.0.0.1:11434
OCR_MODEL=glm-ocr:bf16
EXTRACT_MODEL=gemma4:e2b
UPLOAD_DIR=uploads
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=5
PDF_DPI=150
# Images (and rendered PDF pages) are shrunk so their long side is at most this many pixels before OCR.
MAX_IMAGE_PX=1024
OLLAMA_TIMEOUT_MS=600000
